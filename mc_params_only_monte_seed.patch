+/* PDK funcname registry: maps (abs_var, sigma) → funcname so agauss() can
+ * append the parameter type name to the instance path, turning generic
+ * "x1.x1.x0.x1" names into "x1.x1.x0.x1.mis_vth". Populated by
+ * mc_agauss_register_func() called from inpcom.c when each agauss .func
+ * entry is created (before macro expansion inlines the name away). */
+#define MC_FUNC_TABLE_SIZE 256
+
+typedef struct {
+    double abs_var;
+    double sigma;
+    char   name[MC_NAME_MAX];
+} mc_func_entry_t;
+
+static mc_func_entry_t s_mc_func_table[MC_FUNC_TABLE_SIZE];
+static int             s_mc_func_count = 0;
+
+void mc_agauss_clear_func_table(void) { s_mc_func_count = 0; }
+
+void mc_agauss_register_func(const char *funcname, double abs_var, double sigma)
+{
+    if (!funcname || s_mc_func_count >= MC_FUNC_TABLE_SIZE)
+        return;
+    s_mc_func_table[s_mc_func_count].abs_var = abs_var;
+    s_mc_func_table[s_mc_func_count].sigma   = sigma;
+    strncpy(s_mc_func_table[s_mc_func_count].name, funcname, MC_NAME_MAX - 1);
+    s_mc_func_table[s_mc_func_count].name[MC_NAME_MAX - 1] = '\0';
+    s_mc_func_count++;
+}
+
+static const char *
+mc_lookup_funcname(double abs_var, double sigma)
+{
+    for (int i = 0; i < s_mc_func_count; i++) {
+        if (fabs(s_mc_func_table[i].abs_var - abs_var) < 1e-20 &&
+            fabs(s_mc_func_table[i].sigma   - sigma)   < 1e-20)
+            return s_mc_func_table[i].name;
+    }
+    return NULL;
+}
