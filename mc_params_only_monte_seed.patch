+/* ---------- MC agauss sigma-capture for mc_params_only mode ----------
+ * On first pass (capture enabled): records (nominal, abs_var, sigma, draw, name)
+ * for every agauss() call in deck order.  Subsequent seeds call
+ * mc_agauss_redraw() which redraws all N values in the same order
+ * without reloading the deck.  draw = raw N(0,1) value (sigma-normalised
+ * to unit variance, compatible with commercial SPICE MC output formats).
+ *
+ * The entry buffer is heap-allocated and grows by doubling, so there is no
+ * hard limit on the number of statistical parameters per circuit.
+ */
+#define MC_AGAUSS_INIT 256   /* initial buffer capacity; doubles on overflow */
+#define MC_NAME_MAX    512   /* max length for a single hierarchical name */
+
+typedef struct {
+    char  *name;     /* heap-allocated hierarchical param name, e.g. x1.x72.delvto */
+    double nominal;
+    double abs_var;
+    double sigma;
+    double draw;     /* raw N(0,1) draw (unit-variance, sigma-normalised) */
+} mc_agauss_entry_t;
+
+static mc_agauss_entry_t *s_mc_buf     = NULL;
+static int     s_mc_cap      = 0;  /* allocated capacity */
+static int     s_mc_count    = 0;  /* slots used during capture */
+static int     s_mc_total    = 0;  /* frozen after end_capture */
+static bool    s_mc_capture  = 0;
+static bool    s_mc_replay   = 0; /* replay mode: agauss() returns pre-stored draws */
+static int     s_mc_replay_idx = 0;
+static char    s_mc_cur_name[MC_NAME_MAX] = ""; /* set by nupa_assignment before formula() */
+static char    s_mc_elem_base[MC_NAME_MAX] = "";/* element path without type char (for M-lines) */
+static dico_t *s_mc_cur_dico = NULL;            /* dico at time of name set */
+
+/* Grow the buffer to hold at least one more entry. Returns 1 on success. */
+static int mc_agauss_buf_grow(void)
+{
+    int new_cap = (s_mc_cap == 0) ? MC_AGAUSS_INIT : s_mc_cap * 2;
+    mc_agauss_entry_t *p = realloc(s_mc_buf, (size_t)new_cap * sizeof(*p));
+    if (!p) {
+        fprintf(stderr, "mc_agauss: out of memory growing buffer to %d entries\n", new_cap);
+        return 0;
+    }
+    s_mc_buf = p;
+    s_mc_cap = new_cap;
+    return 1;
+}
+
+/* Free all per-entry name strings and the buffer itself. */
+static void mc_agauss_buf_free(void)
+{
+    int i;
+    for (i = 0; i < s_mc_count; i++) {
+        free(s_mc_buf[i].name);
+        s_mc_buf[i].name = NULL;
+    }
+    free(s_mc_buf);
+    s_mc_buf  = NULL;
+    s_mc_cap  = 0;
+    s_mc_count = 0;
+    s_mc_total = 0;
+}
+
+void mc_agauss_clear_func_table(void); /* forward declaration; defined below */
+
+/* Public entry point: release the capture buffer and all heap-allocated names.
+ * Called by runcoms.c after the mc_params_only loop completes. */
+void mc_agauss_free_buf(void) { mc_agauss_buf_free(); }
+
+void mc_agauss_start_capture(void) {
+    mc_agauss_buf_free();   /* release any previous run's names and buffer */
+    s_mc_capture = 1;
+    mc_agauss_clear_func_table();
+}
+
+int mc_agauss_end_capture(void) {
+    s_mc_capture = 0;
+    s_mc_total   = s_mc_count;
+    return s_mc_total;
+}
+
+void mc_agauss_start_replay(void) { s_mc_replay = 1; s_mc_replay_idx = 0; }
+void mc_agauss_end_replay(void)   { s_mc_replay = 0; }
+
+int         mc_agauss_get_count(void)     { return s_mc_total; }
+double      mc_agauss_get_draw(int i)     { return (i >= 0 && i < s_mc_total) ? s_mc_buf[i].draw    : 0.0; }
+const char *mc_agauss_get_name(int i)     { return (i >= 0 && i < s_mc_total && s_mc_buf[i].name) ? s_mc_buf[i].name : ""; }
+double      mc_agauss_get_nominal(int i)  { return (i >= 0 && i < s_mc_total) ? s_mc_buf[i].nominal : 0.0; }
+double      mc_agauss_get_abs_var(int i)  { return (i >= 0 && i < s_mc_total) ? s_mc_buf[i].abs_var : 0.0; }
+double      mc_agauss_get_sigma(int i)    { return (i >= 0 && i < s_mc_total) ? s_mc_buf[i].sigma   : 0.0; }
+
+/* Redraw all agauss values using a deterministic seed derived from seed_index.
+ * Uses ngspice's own RNG (srand -> TausSeed -> gauss1) so the sequence is
+ * consistent with any run that sets 'set rndseed=seed_index'.
+ * Every call with the same seed_index produces identical draws, making
+ * any row in mc_params.mc independently reproducible. */
+void mc_agauss_redraw_seeded(int seed_index) {
+    srand((unsigned int)seed_index);
+    TausSeed();
+    for (int i = 0; i < s_mc_total; i++)
+        s_mc_buf[i].draw = gauss1();
+}
+
+/* Legacy unseeded redraw (continuous RNG chain — not reproducible). */
+void mc_agauss_redraw(void) {
+    for (int i = 0; i < s_mc_total; i++)
+        s_mc_buf[i].draw = gauss1();
+}
