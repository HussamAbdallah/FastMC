+/* Build "x1.x72.delvto" from the dico instance-name stack + local param name. */
+static void
+mc_build_full_name(char *out, int out_size, dico_t *dico, const char *local_name)
+{
+    out[0] = '\0';
+    if (dico) {
+        int d;
+        for (d = 1; d <= dico->stack_depth; d++) {
+            if (dico->inst_name && dico->inst_name[d]) {
+                size_t rem = (size_t)out_size - strlen(out) - 1;
+                if (out[0] != '\0')
+                    strncat(out, ".", rem);
+                rem = (size_t)out_size - strlen(out) - 1;
+                strncat(out, dico->inst_name[d], rem);
+            }
+        }
+    }
+    if (local_name && local_name[0] != '\0') {
+        size_t rem = (size_t)out_size - strlen(out) - 1;
+        if (out[0] != '\0')
+            strncat(out, ".", rem);
+        rem = (size_t)out_size - strlen(out) - 1;
+        strncat(out, local_name, rem);
+    }
